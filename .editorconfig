root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.ftl]
insert_final_newline = false

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf

[*.sh]
end_of_line = lf

[gradlew]
end_of_line = lf
